{
  "name": "feed-briefly",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "corepack pnpm -r --parallel run dev",
    "dev:api": "corepack pnpm --filter @feed-briefly/api dev",
    "dev:web": "corepack pnpm --filter @feed-briefly/web dev",
    "build": "corepack pnpm -r run build",
    "test": "corepack pnpm --filter @feed-briefly/api test",
    "lint": "corepack pnpm -r run lint"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.86.0",
    "oxlint": "1.86.0"
  }
}
